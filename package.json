{
    "name": "mime-explorer",
    "version": "2.0.0",
    "description": "Look up MIME types, file extensions and metadata, and register your own mappings.",
    "type": "module",
    "main": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.mjs"
        },
        "./db": {
            "types": "./dist/db.d.ts",
            "default": "./dist/db.mjs"
        }
    },
    "files": [
        "dist/"
    ],
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly",
        "build:js": "tsdown",
        "build": "node bin/db.cjs && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build:js",
        "commit": "npx git-cz",
        "lint": "eslint src AGENTS.md CLAUDE.md .agents",
        "lint:fix": "npm run lint -- --fix",
        "test": "npm run test:types && cross-env NODE_ENV=test vitest run --config test/vitest.config.mts",
        "test:types": "tsc -p test/types/tsconfig.json",
        "test:package": "tsc -p test/package/tsconfig.json && node test/package/esm.mjs && node test/package/cjs.cjs",
        "test:coverage": "npm test -- --coverage",
        "prepare": "husky",
        "prepublishOnly": "npm run build"
    },
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "license": "MIT",
    "keywords": [
        "mime",
        "mime-type",
        "mime-types",
        "extesnion",
        "extensions"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tada5hi/mime-explorer.git"
    },
    "bugs": {
        "url": "https://github.com/Tada5hi/mime-explorer/issues"
    },
    "homepage": "https://github.com/Tada5hi/mime-explorer#readme",
    "devDependencies": {
        "@tada5hi/commitlint-config": "^1.3.3",
        "@tada5hi/eslint-config": "^3.3.1",
        "@tada5hi/tsconfig": "^0.7.2",
        "@types/node": "^24.19.2",
        "@vitest/coverage-v8": "^5.1.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.14.0",
        "husky": "^9.1.7",
        "mime-db": "^1.54.0",
        "tsdown": "^0.23.7",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.2",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@ebec/core": "^1.3.2"
    }
}
