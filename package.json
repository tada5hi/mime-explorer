{
    "name": "mime-explorer",
    "version": "1.1.0",
    "description": "Look up MIME types, file extensions and metadata, and register your own mappings.",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./db": {
            "types": "./dist/db.d.ts",
            "import": "./dist/db.mjs",
            "require": "./dist/db.cjs"
        }
    },
    "files": [
        "dist/"
    ],
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly",
        "build:js": "tsdown",
        "build": "node bin/db.js && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build:js",
        "commit": "npx git-cz",
        "lint": "eslint src AGENTS.md CLAUDE.md .agents",
        "lint:fix": "npm run lint -- --fix",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.mts",
        "test:coverage": "npm test -- --coverage",
        "prepare": "husky",
        "prepublishOnly": "npm run build"
    },
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "license": "MIT",
    "keywords": [
        "mime",
        "mime-type",
        "mime-types",
        "extesnion",
        "extensions"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tada5hi/mime-explorer.git"
    },
    "bugs": {
        "url": "https://github.com/Tada5hi/mime-explorer/issues"
    },
    "homepage": "https://github.com/Tada5hi/mime-explorer#readme",
    "devDependencies": {
        "@tada5hi/commitlint-config": "^1.3.3",
        "@tada5hi/eslint-config": "^3.3.1",
        "@tada5hi/tsconfig": "^0.7.2",
        "@types/node": "^24.19.2",
        "@vitest/coverage-v8": "^5.1.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.14.0",
        "husky": "^9.1.7",
        "mime-db": "^1.54.0",
        "tsdown": "^0.23.7",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    }
}
