{
    "extends": "@tada5hi/tsconfig",
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "Node16",
        "verbatimModuleSyntax": false,
        "rootDir": "src",
        "outDir": "dist",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules/**/*"
    ]
}
